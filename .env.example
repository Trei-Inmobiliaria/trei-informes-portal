# ─────────────────────────────────────────────────────────────
# Variables de entorno del Portal de Informes (Auth.js + Entra ID)
# Copiar como variables en Vercel (Project → Settings → Environment Variables).
# NO subir el archivo .env real al repo.
# ─────────────────────────────────────────────────────────────

# Secret de Auth.js (generar uno nuevo: openssl rand -base64 32)
AUTH_SECRET=

# App de Entra REUTILIZADA (mismos valores que el worker trei-informe-auth):
AUTH_MICROSOFT_ENTRA_ID_ID=            # = ENTRA_CLIENT_ID del worker
AUTH_MICROSOFT_ENTRA_ID_SECRET=        # = ENTRA_CLIENT_SECRET del worker
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0

# Confía en el host de Vercel (necesario para el callback).
AUTH_TRUST_HOST=true

# Lista SEMILLA (coma): se usa mientras Edge Config esté vacío o caído.
# ALLOWED_EMAILS=smendez@trei.cl,pelgueta@trei.cl,finanzas@trei.cl,nicole.jaramillo@ivcb.cl

# ── Gestor de Accesos (/accesos) ────────────────────────────────
# Connection string del Edge Config (la crea Vercel al conectarlo al proyecto).
# EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=xxx
# Token de la API de Vercel con permiso de escritura sobre ese Edge Config.
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=            # solo si el Edge Config vive en un team
# Super-admins: siempre entran y administran (coma).
# ADMIN_EMAILS=smendez@trei.cl
# Pestaña "Panel de Salud" del portal.
# PANEL_SALUD_URL=https://trei-panel-salud.smendez.workers.dev/salud/
