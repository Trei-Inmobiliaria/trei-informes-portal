# ─────────────────────────────────────────────────────────────
# Variables de entorno del Portal de Informes (Auth.js + Entra ID)
# Copiar como variables en Vercel (Project → Settings → Environment Variables).
# NO subir el archivo .env real al repo.
# ─────────────────────────────────────────────────────────────

# Secret de Auth.js (generar uno nuevo: openssl rand -base64 32)
AUTH_SECRET=

# App de Entra REUTILIZADA (mismos valores que el worker trei-informe-auth):
AUTH_MICROSOFT_ENTRA_ID_ID=            # = ENTRA_CLIENT_ID del worker
AUTH_MICROSOFT_ENTRA_ID_SECRET=        # = ENTRA_CLIENT_SECRET del worker
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# (Opcional) Segundo tenant: VCB Constructora (razo.cl / ivcb.cl). Al definirlo
# aparece el botón "Tengo cuenta de VCB Constructora / Razo" en /login.
# Requiere en Azure la redirect URI https://trei-informes.app/api/auth/callback/microsoft-entra-id-vcb
AUTH_MICROSOFT_ENTRA_ID_ISSUER_VCB=https://login.microsoftonline.com/abdc3869-dbf7-4003-9a49-0658810938b0/v2.0

# Confía en el host de Vercel (necesario para el callback).
AUTH_TRUST_HOST=true

# Lista SEMILLA (coma): se usa mientras Edge Config esté vacío o caído.
# ALLOWED_EMAILS=smendez@trei.cl,pelgueta@trei.cl,finanzas@trei.cl,nicole.jaramillo@ivcb.cl

# ── Gestor de Accesos (/accesos) ────────────────────────────────
# Connection string del Edge Config (la crea Vercel al conectarlo al proyecto).
# EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=xxx
# Token de la API de Vercel con permiso de escritura sobre ese Edge Config.
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=            # solo si el Edge Config vive en un team
# Super-admins: siempre entran y administran (coma).
# ADMIN_EMAILS=smendez@trei.cl
# Pestaña "Panel de Salud" del portal.
# PANEL_SALUD_URL=https://trei-panel-salud.smendez.workers.dev/salud/

# ── Informe Comercial (/ir/comercial) ──────────────────────────
# Reemplaza al proxy PHP de trei.cl/informe_ventas/db. El HTML y el plano del
# loteo se leen de Supabase Storage (los sube el pipeline bbdd-planok-trei).
# Si estas dos no están, el route handler cae al archivo versionado en
# /privado/comercial/, útil para desarrollo local.
# COMERCIAL_FUENTE_URL=https://<ref>.supabase.co/storage/v1/object/reportes
# COMERCIAL_FUENTE_TOKEN=            # service_role del proyecto Supabase

# Puente de datos: /api/comercial/db/* firma un JWT HS256 con el email del
# usuario y lo pasa a Supabase REST, para que las RLS (mi_email(),
# rol_efectivo(), mis_proyectos_ext()) filtren por quien pregunta — distintos
# usuarios ven distintos proyectos por diseño. Si falta JWT_SECRET el puente
# devuelve 500 a propósito, para no servir datos sin filtro.
# COMERCIAL_SB_URL=https://<ref>.supabase.co
# COMERCIAL_SB_KEY=                  # anon del proyecto Supabase (apikey del gateway)
# COMERCIAL_SB_JWT_SECRET=           # JWT secret del proyecto (Settings → API)
